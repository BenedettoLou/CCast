CXX = clang++
CXXFLAGS = -std=c++20 -Wall -Wextra -Isrc
OBJCXXFLAGS = $(CXXFLAGS) -fobjc-arc
DEPFLAGS = -MMD -MP
LDFLAGS = -framework Cocoa -framework Carbon

TARGET = ccast
BUILD = build

# Objective-C++ (UI) and pure C++ (core) sources
SRCS_MM  = src/main.mm src/ui/window.mm src/ui/search.mm src/ui/resultViews.mm src/ui/hotkey.mm
SRCS_CPP = src/core/searchEngine.cpp src/core/searchFile.cpp

OBJS = $(patsubst src/%,$(BUILD)/%.o,$(SRCS_MM) $(SRCS_CPP))

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) $(OBJS) $(LDFLAGS) -o $(TARGET)

$(BUILD)/%.mm.o: src/%.mm
	@mkdir -p $(dir $@)
	$(CXX) $(OBJCXXFLAGS) $(DEPFLAGS) -c $< -o $@

$(BUILD)/%.cpp.o: src/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) $(DEPFLAGS) -c $< -o $@

# header dependencies generated by -MMD
-include $(OBJS:.o=.d)

clean:
	rm -rf $(BUILD) $(TARGET) a.out

run: all
	./$(TARGET)

.PHONY: all clean run
